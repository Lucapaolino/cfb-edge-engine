FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# This intentionally uses the existing locked CFB environment.  The native
# GUI is not launched from this image; this is only a headless portability
# check for the canonical controller.
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY src ./src

ENTRYPOINT ["python", "src/run_game_day_v1.py"]
CMD ["--dry-run"]
